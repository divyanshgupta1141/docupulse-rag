# Application
PROJECT_NAME="DocuPulse RAG Assistant"
ENV="development"
DEBUG=true

# Database & Vector Store
SQLITE_DB_PATH="sqlite:///./docupulse.db"
QDRANT_MODE="memory" # "memory" for in-memory, "local" for local disk storage
QDRANT_PATH="./qdrant_storage"
QDRANT_COLLECTION="document_chunks"

# Ingestion & Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
SIMILARITY_THRESHOLD=0.20
MAX_FILE_SIZE_MB=10

# AI Provider Configuration
# Set USE_MOCK_AI=true for fast, deterministic unit testing and zero-cost CI
USE_MOCK_AI=true

# Embedding Provider: "local" (sentence-transformers), "openai", or "mock"
EMBEDDING_PROVIDER="mock"
LOCAL_EMBEDDING_MODEL="all-MiniLM-L6-v2"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# LLM Provider: "groq", "openai", "gemini", or "mock"
LLM_PROVIDER="mock"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
